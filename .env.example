CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_SITE_URL=http://localhost:3000

# Set the same long random value in Vercel and Convex.
SURVEY_API_SECRET=replace-with-a-long-random-secret
# Vercel-only secret used to hash visitor IP addresses before storage.
IP_HASH_SECRET=replace-with-a-different-long-random-secret
# Convex HTTP endpoint used by the Vercel submission function.
CONVEX_SITE_URL=https://your-deployment.convex.site

# Read only by the local seed command. Never commit real credentials.
ADMIN_NAME=Kality Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-unique-password
